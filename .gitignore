# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# pgrx
/.cargo/config
# pgrx auto-emits its own upgrade scripts at build time; we ignore those
# wildcard outputs but force-track every handwritten upgrade we ship with
# the release (each must be added with `git add -f` or be matched by an
# explicit negation here).
/sql/pg_ask--*.sql
!/sql/pg_ask--0.5.1--0.5.2.sql
!/sql/pg_ask--0.5.3--0.5.4.sql
!/sql/pg_ask--0.5.4--0.5.5.sql
!/sql/pg_ask--0.5.5--0.5.6.sql
!/sql/pg_ask--0.5.6--0.5.7.sql
!/sql/pg_ask--0.5.7--0.5.8.sql
!/sql/pg_ask--0.5.8--0.5.9.sql
/target-*

# Packaging build outputs (deb/rpm/apk staging + artefacts)
/dist

# Editor
.idea/
.vscode/
*.swp
.DS_Store

# Local env
.env
.env.*
!.env.example
sentirum_logo.png
